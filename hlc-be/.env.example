# Backend service
PORT=4100
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated frontend origins allowed to call this API.
# Use the exact production domains when deploying.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Future provider configuration
CHAT_PROVIDER=demo
# OPENAI_API_KEY=
# BOOKING_WEBHOOK_URL=

# Turso / libSQL
TURSO_DATABASE_URL=libsql://your-db-url.turso.io
TURSO_AUTH_TOKEN=your-secret-token

# Existing Heartland MySQL database. These four appointment tables must already exist.
APPOINTMENT_DATABASE_URL=mysql://user:password@host:3306/heartland

# Existing IDs used for appointments created by this public widget.
# Each value must reference a valid record in the original database.
APPOINTMENT_GUEST_USER_ID=1
APPOINTMENT_ASSIGNEE_ID=1
APPOINTMENT_BRANCH_ID=1

# Must be one of the real appointments.channel ENUM values (for example, web).
APPOINTMENT_CHANNEL=web

# Must match the timezone used by the original appointment application.
# Use America/Chicago only if the original connection used that named zone.
APPOINTMENT_TIME_ZONE=SYSTEM

# Optional single-process limit for direct deployments only. It keys on the TCP peer,
# so leave it unset behind a reverse proxy and enforce the limit at that trusted edge.
# APPOINTMENT_RATE_LIMIT_MAX=5
